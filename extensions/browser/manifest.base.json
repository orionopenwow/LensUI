{
  "manifest_version": 3,
  "name": "Lens for Browsers",
  "short_name": "Lens",
  "version": "0.1.0",
  "description": "Send pages, selections, links and videos to Lens UI on this PC: ask, summarise, translate, add to your Shelf.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Lens",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "permissions": [
    "contextMenus",
    "nativeMessaging",
    "activeTab",
    "scripting",
    "storage"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "commands": {
    "open-command": {
      "suggested_key": {
        "default": "Alt+Shift+L"
      },
      "description": "Open Lens Command with the selection"
    },
    "add-to-shelf": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Add the selection (or page) to the Lens Shelf"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'none'"
  },
  "chromium": {
    "key": "",
    "background": {
      "service_worker": "src/background.js",
      "type": "module"
    },
    "side_panel": {
      "default_path": "src/panel.html"
    },
    "extraPermissions": [
      "sidePanel"
    ],
    "minimum_chrome_version": "120"
  },
  "firefox": {
    "background": {
      "scripts": [
        "src/background.js"
      ],
      "type": "module"
    },
    "sidebar_action": {
      "default_title": "Lens",
      "default_panel": "src/panel.html",
      "default_icon": "icons/icon32.png",
      "open_at_install": false
    },
    "browser_specific_settings": {
      "gecko": {
        "id": "lens-bridge@lensui.app",
        "strict_min_version": "128.0"
      }
    }
  }
}
