@echo off
powershell -NoProfile -Command "Add-Type 'using System; using System.Runtime.InteropServices; public class TB { [StructLayout(LayoutKind.Sequential)] public struct R { public int L,T,R2,B; } [StructLayout(LayoutKind.Sequential)] public struct ABD { public int cb; public IntPtr hw; public uint cbMsg; public uint edge; public R rc; public IntPtr lp; } [DllImport(\"user32.dll\")] public static extern IntPtr FindWindow(string c, string t); [DllImport(\"user32.dll\")] public static extern IntPtr FindWindowEx(IntPtr p, IntPtr a, string c, string t); [DllImport(\"user32.dll\")] public static extern bool ShowWindow(IntPtr h, int cmd); [DllImport(\"shell32.dll\")] public static extern uint SHAppBarMessage(uint m, ref ABD d); public static void Go() { var h=FindWindow(\"Shell_TrayWnd\",null); if(h!=IntPtr.Zero){ var d=new ABD{cb=Marshal.SizeOf(typeof(ABD)),hw=h,lp=IntPtr.Zero}; SHAppBarMessage(10,ref d); ShowWindow(h,5); } IntPtr p=IntPtr.Zero; while((p=FindWindowEx(IntPtr.Zero,p,\"Shell_SecondaryTrayWnd\",null))!=IntPtr.Zero) ShowWindow(p,5); } }'; [TB]::Go()"
