    "security": {
      "csp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost data: blob:",
        "media-src": "'self' asset: http://asset.localhost blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost http://localhost:* http://127.0.0.1:*",
        "frame-src": "'self' asset: http://asset.localhost https://discord.com https://web.telegram.org https://www.messenger.com https://messages.google.com https://web.whatsapp.com https://app.slack.com http://localhost:* http://127.0.0.1:*",
        "worker-src": "'none'",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$DATA/LensUI/plugin-frames/**",
          "$DATA/LensUI/wallpapers/**",
          "$DATA/LensUI/apps/media/**"
        ]
      },
      "devCsp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "script-src": "'self' 'unsafe-inline' 'unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost data: blob:",
        "media-src": "'self' asset: http://asset.localhost blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost http://localhost:* http://127.0.0.1:* ws://localhost:1420 ws://127.0.0.1:1420",
        "frame-src": "'self' asset: http://asset.localhost https://discord.com https://web.telegram.org https://www.messenger.com https://messages.google.com https://web.whatsapp.com https://app.slack.com http://localhost:* http://127.0.0.1:*",
        "worker-src": "'none'",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "publisher": "Lens UI contributors",
    "copyright": "MIT \u00a9 2026 Lens UI contributors",
    "shortDescription": "Calm, themeable desktop shell for Windows 10 and 11",
    "homepage": "https://orionopenwow.github.io/lensui/"
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://github.com/orionopenwow/lensui/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
