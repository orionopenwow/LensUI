{
  "name": "lens-ui",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Lens UI — a calm, themeable desktop shell for Windows 10 and 11",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "parity": "node tools/parity/build.mjs && node tools/parity/shoot.mjs",
    "test": "bun test src/__tests__",
    "gen:types": "python3 tools/gen-types/gen_types.py",
    "gen:catalogue": "node -e \"require('child_process').execSync('cargo test --lib export_catalogue',{cwd:'src-tauri',stdio:'inherit',env:{...process.env,LENS_WRITE_CATALOGUE:'1'}})\"",
    "ext:build": "node extensions/browser/build.mjs",
    "ext:check": "node extensions/browser/build.mjs --check"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.2.0",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
